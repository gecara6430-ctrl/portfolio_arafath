# =============================================================
# Configuration du portfolio Koffi S. — copier vers .env.local
# cp .env.example .env.local
# =============================================================

# --- Formulaire de contact (SMTP, requis pour POST /api/contact) ---
# Sans ces 3 variables, l'API répond 503 "Service d'envoi non configuré".
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=utilisateur@example.com
SMTP_PASS=change-moi

# Expéditeur affiché (optionnel, défaut : SMTP_USER)
SMTP_FROM="Portfolio Koffi <utilisateur@example.com>"

# Destinataire des messages du formulaire
CONTACT_TO=gecara6430@gamil.com

# --- Déploiement Vercel ---
# Aucune variable requise pour le front. Renseigner SMTP_* dans
# Vercel → Project → Settings → Environment Variables avant mise en production.
